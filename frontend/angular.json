{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"chatwave": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist/chatwave",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "tsconfig.app.json",
						"styles": ["src/styles.css"],
						"assets": [{
							"glob": "**/*",
							"input": "src/assets",
							"output": "assets"
						}]
					},
					"configurations": {
						"production": {
							"budgets": [{
								"type": "initial",
								"maximumWarning": "1mb",
								"maximumError": "2mb"
							}],
							"outputHashing": "all"
						}
					}
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"options": {
						"buildTarget": "chatwave:build"
					},
					"configurations": {
						"production": {
							"buildTarget": "chatwave:build:production"
						}
					}
				}
			}
		}
	},
	"cli": {
		"analytics": false
	}
}